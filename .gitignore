# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# screenshots: the default destination of `npm run shots`. The copies that
# outlive a session go outside the repo — see AGENTS.md.
/.screenshots/
/test-results/

# shot files are written by the session that needs them and die with it. What a
# capture proves belongs in the PR that took it, not in the repo: nothing runs
# these, so a tracked one rots silently and is found by whoever tries to use it.
tools/screenshots/*.shots.ts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (local settings, not shared)
.claude/settings.local.json
